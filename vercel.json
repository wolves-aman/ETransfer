{
  "buildCommand": "npm --prefix client install && npm --prefix client run build",
  "outputDirectory": "client/dist",
  "build": {
    "env": {
      "VUE_APP_SIGNAL_TRANSPORT": "sse"
    }
  },
  "functions": {
    "api/sse.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/events",
      "destination": "/api/sse?route=events"
    },
    {
      "source": "/api/signal",
      "destination": "/api/sse?route=signal"
    },
    {
      "source": "/api/health",
      "destination": "/api/sse?route=health"
    }
  ]
}
